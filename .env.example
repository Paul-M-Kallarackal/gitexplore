GITEXPLORE_GITHUB_CLIENT_ID=replace-me
GITEXPLORE_GITHUB_CLIENT_SECRET=replace-me
GITEXPLORE_GITHUB_REDIRECT_URI=http://localhost:4000/auth/oauth/callback
GITEXPLORE_GITHUB_SCOPES=read:user
# Generate a unique 32-byte unpadded base64url key; never reuse the Compose dev fallback in production.
GITEXPLORE_IDENTITY_ENCRYPTION_KEY=
GITEXPLORE_FRONTEND_ORIGIN=http://localhost:3000
# Optional Vite development-proxy target. Browser code remains same-origin.
GITEXPLORE_DEV_API_BASE_URL=http://127.0.0.1:4000
GITEXPLORE_DEPLOYMENT_MODE=local

NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=gitexplore-dev-password
GITEXPLORE_NEO4J_DATABASE=neo4j
# Optional locally. Production must set capacity headroom below the provider's hard limits.
GITEXPLORE_NEO4J_MAX_TOTAL_NODES=
GITEXPLORE_NEO4J_MAX_TOTAL_RELATIONSHIPS=
