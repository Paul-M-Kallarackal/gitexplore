# syntax=docker/dockerfile:1.7

FROM rust:1.91.0-bookworm AS builder
WORKDIR /workspace

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY docker/neo4j/init ./docker/neo4j/init
COPY .gitexplore-release ./.gitexplore-release

RUN set -eu; \
    if [ -f /workspace/.gitexplore-release/gitexplore ] \
        || [ -f /workspace/.gitexplore-release/source.sha256 ]; then \
        test -f /workspace/.gitexplore-release/gitexplore; \
        test -f /workspace/.gitexplore-release/source.sha256; \
        export LC_ALL=C; \
        expected_source="$(cat /workspace/.gitexplore-release/source.sha256)"; \
        actual_source="$(find Cargo.toml Cargo.lock rust-toolchain.toml src docker/neo4j/init \
            -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | cut -d ' ' -f 1)"; \
        test "$actual_source" = "$expected_source"; \
        install -m 0755 /workspace/.gitexplore-release/gitexplore /tmp/gitexplore; \
        /tmp/gitexplore --help >/dev/null; \
    else \
        cargo build --locked --release; \
        cp /workspace/target/release/gitexplore /tmp/gitexplore; \
    fi

FROM debian:bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 gitexplore \
    && useradd --uid 10001 --gid gitexplore --system --create-home gitexplore \
    && install -d -o gitexplore -g gitexplore /tmp/gitexplore

COPY --from=builder --chown=gitexplore:gitexplore /tmp/gitexplore /usr/local/bin/gitexplore

RUN gitexplore --help >/dev/null

ENV PORT=80 \
    GITEXPLORE_DEPLOYMENT_MODE=production \
    GITEXPLORE_GRAPH_BACKEND=neo4j \
    GITEXPLORE_NEO4J_MAX_TOTAL_NODES=190000 \
    GITEXPLORE_NEO4J_MAX_TOTAL_RELATIONSHIPS=380000 \
    GITEXPLORE_DATA_DIR=/tmp/gitexplore

USER gitexplore
EXPOSE 80
STOPSIGNAL SIGTERM

CMD ["gitexplore", "serve"]
